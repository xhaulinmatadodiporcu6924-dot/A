<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <SurfaceView
        android:id="@+id/gameSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/btnSelectBios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Selecionar BIOS (.bin)" />

        <Button
            android:id="@+id/btnSelectRom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Selecionar Jogo/ROM (.iso / .chd)" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#2E7D32"
            android:text="3. Jogar" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <Button
            android:id="@+id/btnDpadUp"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="50dp"
            android:layout_marginBottom="100dp"
            android:text="↑" />

        <Button
            android:id="@+id/btnCross"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="60dp"
            android:layout_marginBottom="30dp"
            android:text="X" />

        <Button
            android:id="@+id/btnCircle"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="80dp"
            android:text="O" />
    </RelativeLayout>

</RelativeLayout>
