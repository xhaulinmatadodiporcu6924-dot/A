<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Tela de vídeo do jogo -->
    <SurfaceView
        android:id="@+id/gameSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Menu inicial de seleção -->
    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="32dp"
        android:background="#E61E1E1E"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnSelectBios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Selecionar BIOS (.bin)" />

        <Button
            android:id="@+id/btnSelectRom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2. Selecionar Jogo/ROM (.iso / .chd)" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#2E7D32"
            android:text="3. Jogar" />
    </LinearLayout>

    <!-- Controles completos do DualShock 2 na tela -->
    <RelativeLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Ombros Esquerdos (L2 e L1) -->
        <Button
            android:id="@+id/btnL2"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:alpha="0.7"
            android:text="L2" />

        <Button
            android:id="@+id/btnL1"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:layout_below="@id/btnL2"
            android:layout_alignParentStart="true"
            android:alpha="0.7"
            android:text="L1" />

        <!-- Ombros Direitos (R2 e R1) -->
        <Button
            android:id="@+id/btnR2"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:alpha="0.7"
            android:text="R2" />

        <Button
            android:id="@+id/btnR1"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:layout_below="@id/btnR2"
            android:layout_alignParentEnd="true"
            android:alpha="0.7"
            android:text="R1" />

        <!-- Direcional (D-Pad) -->
        <Button
            android:id="@+id/btnDpadUp"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="58dp"
            android:layout_marginBottom="112dp"
            android:alpha="0.7"
            android:text="↑" />

        <Button
            android:id="@+id/btnDpadDown"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="58dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.7"
            android:text="↓" />

        <Button
            android:id="@+id/btnDpadLeft"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="60dp"
            android:alpha="0.7"
            android:text="←" />

        <Button
            android:id="@+id/btnDpadRight"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="110dp"
            android:layout_marginBottom="60dp"
            android:alpha="0.7"
            android:text="→" />

        <!-- Botões Centrais (Select e Start) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSelect"
                android:layout_width="76dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:alpha="0.7"
                android:text="SELECT"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="76dp"
                android:layout_height="40dp"
                android:alpha="0.7"
                android:text="START"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Botões de Ação (Triângulo, Círculo, X, Quadrado) -->
        <Button
            android:id="@+id/btnTriangle"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="58dp"
            android:layout_marginBottom="112dp"
            android:alpha="0.7"
            android:text="△" />

        <Button
            android:id="@+id/btnCross"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="58dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.7"
            android:text="✕" />

        <Button
            android:id="@+id/btnSquare"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="110dp"
            android:layout_marginBottom="60dp"
            android:alpha="0.7"
            android:text="□" />

        <Button
            android:id="@+id/btnCircle"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="60dp"
            android:alpha="0.7"
            android:text="○" />

    </RelativeLayout>

</RelativeLayout>
